NODE_ENV=development
PORT=4000
WEB_PORT=3000
DATABASE_URL=postgresql://poker:poker@localhost:5432/pokerdb
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-strong-access-secret-min-24
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret-min-24
SESSION_COOKIE_NAME=poker_sid
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=1
SIGNER_BASE_URL=http://localhost:4500
BTC_RPC_URL=https://btc-rpc.example
ERC20_RPC_URL=https://eth-rpc.example
TRC20_RPC_URL=https://tron-rpc.example
CASHIER_DEFAULT_CONFIRMATIONS=3
WITHDRAWAL_COOLDOWN_MINUTES=10
WATCHER_INGEST_TOKEN=dev-watcher-ingest-token

EMAIL_PROVIDER=noop
RESEND_API_KEY=
EMAIL_FROM=security@poker.local
